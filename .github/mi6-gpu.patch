+/*
+ * mi6: 抢占包策略，三档。
+ *   0 = 一个抢占包都不发（单 ring 用；多 ring 下 CP 不会切上下文，
+ *       非当前 ring 的 IB 永不被消费）；
+ *   1 = fine-grain：submit 内发 ENABLE_LOCAL/YIELD_ENABLE，IB 末尾发
+ *       CP_CONTEXT_SWITCH_YIELD。这是老 upstream 行为，但 Mesa 至今没有
+ *       在 IB 里做 fine-grain 抢占所需的 tiling/GMEM 重放，upstream 已用
+ *       「a5xx: disable preemption in submits by default」把它关掉；
+ *   2 = 仅粗粒度（默认）：只在 submit 开头发 ENABLE_GLOBAL + SAVE_ADDR，
+ *       不做 IB 内的 checkpoint，切换只发生在 submit 边界的
+ *       CACHE_FLUSH_TS 中断里（由 a5xx_preempt_trigger 写 CNTL）。
+ *
+ * v8 实测（pkts=1 + 4 ring + pp_as=1）：单进程第一次 ping 即卡死 ——
+ * ring0 的 IB 被读完（rptr==wptr）但 fence 不 retire，ring2 的 IB
+ * 永不被消费，dmesg 见 *** gpu fault: iova=0x001c2000（落在 gpu->vm
+ * 但无映射）。改粗粒度后不再有 IB 中途的上下文切换。
+ */
+static int a5xx_preempt_pkts = 2;
+module_param_named(a5xx_preempt_pkts, a5xx_preempt_pkts, int, 0600);
+MODULE_PARM_DESC(a5xx_preempt_pkts, "mi6: 0=none, 1=fine-grain (needs mesa support), 2=coarse only (default)");
+
+/* mi6: 抢占链路日志开关（trigger 决策 / preempt irq 的 CNTL 读值），限流 200 条 */
+int a5xx_dbg = 1;
+module_param_named(a5xx_dbg, a5xx_dbg, int, 0600);
+MODULE_PARM_DESC(a5xx_dbg, "mi6: 1=log preempt decision path (rate limited), 0=off");
