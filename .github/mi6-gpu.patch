diff -Naur a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c	2026-11-13 04:06:23.943065197 +0000
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c	2026-11-13 04:50:54.416383435 +0000
@@ -12,6 +12,43 @@
 #include "msm_gem.h"
 #include "msm_mmu.h"
 #include "a5xx_gpu.h"
+#include <linux/moduleparam.h>
+#include <linux/err.h>
+
+/* ==== mi6: GPU 回退/诊断开关 ==== */
+/*
+ * mi6: 默认 1 = fork 的 per-process GPU 地址空间（每个进程独立页表，
+ * 提交前由 a5xx_set_pagetable() 切 TTBR0 并刷 uche）。
+ *
+ * v8：nr_rings 默认 4、whereami 默认 -1（信任固件检测），即回到 fork
+ * 原生的「多 ring + 硬件抢占」路径。实测 ucode hdr 005ff08a/00000f43/
+ * 00087001 的检测值就是 whereami=1（patched microcode），此前被本开关
+ * 强制为 0，导致 hw_init 把 nr_rings 降回 1、抢占永不启用；
+ * pp_as=1 仍必需：0 时短命进程循环必挂（v7 结论）。
+ * 本次默认组合 = fork 原生：4 ring + whereami auto + pp_as on。
+ */
+static int a5xx_pp_as = 1;
+module_param_named(a5xx_pp_as, a5xx_pp_as, int, 0600);
+MODULE_PARM_DESC(a5xx_pp_as, "mi6: 1=per-process GPU address space (fork, default), 0=shared (upstream)");
+
+static int a5xx_nr_rings = 4;
+module_param_named(a5xx_nr_rings, a5xx_nr_rings, int, 0600);
+MODULE_PARM_DESC(a5xx_nr_rings, "mi6: ring count, default 4 = preemption on (fork default), 1 disables preemption");
+
+static int a5xx_whereami = -1;
+module_param_named(a5xx_whereami, a5xx_whereami, int, 0600);
+MODULE_PARM_DESC(a5xx_whereami, "mi6: -1=auto, 0=force no WHERE_AM_I, 1=force yes");
+
+/*
+ * mi6: 0=永不发抢占包, 1=只在多 ring 时发（默认）。
+ * 单 ring 下 a5xx_preempt_trigger()/hw_init()/init() 全部提前返回，
+ * CP_CONTEXT_SWITCH_RESTORE_ADDR 永远是 0；一旦 CP 在
+ * CP_CONTEXT_SWITCH_YIELD 处真的切上下文，就会从 iova 0 读恢复记录
+ * → SMMU 读 fault(iova=0) → opcode 0x00000000 → CP 卡死。
+ */
+static int a5xx_preempt_pkts = 1;
+module_param_named(a5xx_preempt_pkts, a5xx_preempt_pkts, int, 0600);
+MODULE_PARM_DESC(a5xx_preempt_pkts, "mi6: 0=never emit preempt packets, 1=only when nr_rings>1");
 
 extern bool hang_debug;
 static void a5xx_dump(struct msm_gpu *gpu);
@@ -128,6 +165,9 @@
 	u32 asid;
 	u64 memptr = rbmemptr(ring, ttbr0);
 
+	if (!a5xx_pp_as)
+		return;
+
 	if (ctx == a5xx_gpu->cur_ctx)
 		return;
 
@@ -169,6 +209,9 @@
 	struct a5xx_gpu *a5xx_gpu = to_a5xx_gpu(adreno_gpu);
 	struct msm_ringbuffer *ring = submit->ring;
 	unsigned int i, ibs = 0;
+	bool preempt;
+
+	preempt = (a5xx_preempt_pkts == 1) && (gpu->nr_rings > 1);
 
 	if (IS_ENABLED(CONFIG_DRM_MSM_GPU_SUDO) && submit->in_rb) {
 		gpu->cur_ctx_seqno = 0;
@@ -176,31 +219,42 @@
 		return;
 	}
 
-	OUT_PKT7(ring, CP_PREEMPT_ENABLE_GLOBAL, 1);
-	OUT_RING(ring, 0x02);
-
-	/* Turn off protected mode to write to special registers */
-	OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
-	OUT_RING(ring, 0);
-
-	/* Set the save preemption record for the ring/command */
-	OUT_PKT4(ring, REG_A5XX_CP_CONTEXT_SWITCH_SAVE_ADDR_LO, 2);
-	OUT_RING(ring, lower_32_bits(a5xx_gpu->preempt_iova[submit->ring->id]));
-	OUT_RING(ring, upper_32_bits(a5xx_gpu->preempt_iova[submit->ring->id]));
-
-	/* Turn back on protected mode */
-	OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
-	OUT_RING(ring, 1);
-
-	/* Enable local preemption for finegrain preemption */
-	//OUT_PKT7(ring, CP_PREEMPT_ENABLE_GLOBAL, 1);
-	//OUT_RING(ring, 0x02);
-	OUT_PKT7(ring, CP_PREEMPT_ENABLE_LOCAL, 1);
-	OUT_RING(ring, 0x01);
-
-	/* Allow CP_CONTEXT_SWITCH_YIELD packets in the IB2 */
-	OUT_PKT7(ring, CP_YIELD_ENABLE, 1);
-	OUT_RING(ring, 0x02);
+	pr_info_once("msm: a5xx submit: nr_rings=%d preempt_pkts=%d -> %s\n",
+		gpu->nr_rings, a5xx_preempt_pkts,
+		preempt ? "发射抢占包+CONTEXT_SWITCH_YIELD" : "不发抢占包/不 yield");
+
+	/*
+	 * mi6: 单 ring 下不发任何抢占包。fork 里 preempt_init()/hw_init()/
+	 * trigger() 在 nr_rings==1 时全部提前返回，CP_CONTEXT_SWITCH_RESTORE_ADDR
+	 * 恒为 0；若仍然发 CP_CONTEXT_SWITCH_YIELD，CP 会去 iova 0 读恢复记录，
+	 * 触发 SMMU 读 fault(iova=0) 与 opcode 0x00000000，随后 fence 永不完成、
+	 * hangcheck 每 2s 一次恢复失败（实测 179 条）。
+	 */
+	if (preempt) {
+		OUT_PKT7(ring, CP_PREEMPT_ENABLE_GLOBAL, 1);
+		OUT_RING(ring, 0x02);
+
+		/* Turn off protected mode to write to special registers */
+		OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
+		OUT_RING(ring, 0);
+
+		/* Set the save preemption record for the ring/command */
+		OUT_PKT4(ring, REG_A5XX_CP_CONTEXT_SWITCH_SAVE_ADDR_LO, 2);
+		OUT_RING(ring, lower_32_bits(a5xx_gpu->preempt_iova[submit->ring->id]));
+		OUT_RING(ring, upper_32_bits(a5xx_gpu->preempt_iova[submit->ring->id]));
+
+		/* Turn back on protected mode */
+		OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
+		OUT_RING(ring, 1);
+
+		/* Enable local preemption for finegrain preemption */
+		OUT_PKT7(ring, CP_PREEMPT_ENABLE_LOCAL, 1);
+		OUT_RING(ring, 0x01);
+
+		/* Allow CP_CONTEXT_SWITCH_YIELD packets in the IB2 */
+		OUT_PKT7(ring, CP_YIELD_ENABLE, 1);
+		OUT_RING(ring, 0x02);
+	}
 
 	a5xx_set_pagetable(a5xx_gpu, ring, submit->queue->ctx);
 
@@ -265,18 +319,20 @@
 	OUT_RING(ring, submit->seqno);
 
 	/* Yield the floor on command completion */
-	OUT_PKT7(ring, CP_CONTEXT_SWITCH_YIELD, 4);
-	/*
-	 * If dword[2:1] are non zero, they specify an address for the CP to
-	 * write the value of dword[3] to on preemption complete. Write 0 to
-	 * skip the write
-	 */
-	OUT_RING(ring, 0x00);
-	OUT_RING(ring, 0x00);
-	/* Data value - not used if the address above is 0 */
-	OUT_RING(ring, 0x01);
-	/* Set bit 0 to trigger an interrupt on preempt complete */
-	OUT_RING(ring, 0x01);
+	if (preempt) {
+		OUT_PKT7(ring, CP_CONTEXT_SWITCH_YIELD, 4);
+		/*
+		 * If dword[2:1] are non zero, they specify an address for the CP to
+		 * write the value of dword[3] to on preemption complete. Write 0 to
+		 * skip the write
+		 */
+		OUT_RING(ring, 0x00);
+		OUT_RING(ring, 0x00);
+		/* Data value - not used if the address above is 0 */
+		OUT_RING(ring, 0x01);
+		/* Set bit 0 to trigger an interrupt on preempt complete */
+		OUT_RING(ring, 0x01);
+	}
 
 	/* A WHERE_AM_I packet is not needed after a YIELD */
 	a5xx_flush(gpu, ring, false);
@@ -610,6 +666,14 @@
 	if (((buf[0] & 0xf) == 0xa) && (buf[2] & 0xf) >= 1)
 		a5xx_gpu->has_whereami = true;
 
+	pr_info("msm: a5xx ucode hdr %08x %08x %08x -> detected whereami=%d\n",
+		buf[0], buf[1], buf[2], a5xx_gpu->has_whereami);
+
+	if (a5xx_whereami >= 0) {
+		a5xx_gpu->has_whereami = !!a5xx_whereami;
+		pr_info("msm: a5xx whereami forced to %d\n", a5xx_gpu->has_whereami);
+	}
+
 	msm_gem_put_vaddr(obj);
 }
 
@@ -992,6 +1056,10 @@
 
 	a5xx_preempt_hw_init(gpu);
 
+	pr_info("msm: a5xx hw_init: nr_rings=%d has_whereami=%d pp_as=%d preempt_pkts=%d\n",
+		gpu->nr_rings, a5xx_gpu->has_whereami, a5xx_pp_as,
+		a5xx_preempt_pkts);
+
 	/* Disable the interrupts through the initial bringup stage */
 	gpu_write(gpu, REG_A5XX_RBBM_INT_0_MASK, A5XX_INT_MASK);
 
@@ -1736,6 +1804,11 @@
 {
 	struct msm_mmu *mmu;
 
+	if (!a5xx_pp_as) {
+		pr_info("msm: a5xx private address space disabled (upstream shared aspace)\n");
+		return ERR_PTR(-EOPNOTSUPP);
+	}
+
 	mmu = msm_iommu_pagetable_create(gpu->aspace->mmu);
 
 	if (IS_ERR(mmu))
@@ -1832,7 +1905,8 @@
 
 	check_speed_bin(&pdev->dev);
 
-	ret = adreno_gpu_init(dev, pdev, adreno_gpu, &funcs, 4);
+	ret = adreno_gpu_init(dev, pdev, adreno_gpu, &funcs,
+			a5xx_nr_rings > 0 ? a5xx_nr_rings : 4);
 	if (ret) {
 		a5xx_destroy(&(a5xx_gpu->base.base));
 		return ERR_PTR(ret);
